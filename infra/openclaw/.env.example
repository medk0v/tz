# The bootstrap script creates infra/openclaw/.env automatically with a random
# gateway token. Keep the real file local and never commit it.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_TZ=Europe/Istanbul
OPENCLAW_GRANT_GID=1000
OPENCLAW_GRANT_HOST_DIR=./runtime/agent-secrets
OPENCLAW_ACTION_HOST_DIR=./runtime/agent-actions
OPENCLAW_SHELL_HOST_DIR=./runtime/shell
# Independent Chromium reads; the backend also limits whole agent executions.
SUPPORT_BROWSER_CONCURRENCY=2

# Add a model provider later, preferably through the OpenClaw Control UI.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
