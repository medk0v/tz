# manage.sh creates .env with a random PostgreSQL password.
FIRECRAWL_RELEASE=v2.11.162
USE_DB_AUTHENTICATION=false
POSTGRES_USER=firecrawl
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
PORT=3002
INTERNAL_PORT=3002
NUM_WORKERS_PER_QUEUE=2
CRAWL_CONCURRENT_REQUESTS=2
MAX_CONCURRENT_JOBS=2
BROWSER_POOL_SIZE=2
BLOCK_MEDIA=true
ALLOW_LOCAL_WEBHOOKS=false
LOGGING_LEVEL=INFO
HARNESS_STARTUP_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=
SEARXNG_ENDPOINT=
SEARXNG_CATEGORIES=
SEARXNG_ENGINES=
SUPABASE_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=
SELF_HOSTED_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
AUTUMN_SECRET_KEY=
TEST_API_KEY=
NUQ_BACKEND=
BULL_AUTH_KEY=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
