#!/usr/bin/env bash
set -euo pipefail
umask 077

command_text="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$command_text" =~ ^scp\ -t\ /var/lib/tz/incoming/(tz-lite(-ai)?-[0-9a-f]{40}\.tar\.gz(\.sha256)?)$ ]]; then
    exec /usr/bin/scp -t "/var/lib/tz/incoming/${BASH_REMATCH[1]}"
fi
if [[ "$command_text" =~ ^sudo\ -n\ /usr/local/sbin/tz-lite-deploy\ ([0-9a-f]{40})$ ]]; then
    exec /usr/bin/sudo -n /usr/local/sbin/tz-lite-deploy "${BASH_REMATCH[1]}"
fi
echo "This SSH account is restricted to TZ Lite artifact uploads and deployment." >&2
exit 64
