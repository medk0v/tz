VITE_API_BASE_URL=http://localhost:8080
# Public sales deployment: landing. Internal deployment: login.
VITE_ENTRY_MODE=landing
# Lite disables the optional opening animation. Use the same edition for admin, widget and loader.
VITE_PRODUCT_EDITION=standard
# Public loader URL shown in the Channels installation instructions.
VITE_WIDGET_LOADER_URL=https://support.example.com/loader/widget-loader.js
# Optional when loader, iframe, and API are served from different origins.
VITE_WIDGET_FRAME_URL=https://support.example.com/widget/widget.html
VITE_WIDGET_API_BASE_URL=https://support.example.com
# Optional for standalone widget development. Production loader passes widget_id in the iframe URL.
VITE_WIDGET_ID=00000000-0000-0000-0000-000000000000
# Optional browser error reporting. The DSN is public; keep SENTRY_AUTH_TOKEN out of VITE_* variables.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
